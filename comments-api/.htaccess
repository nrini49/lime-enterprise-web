# Blog comments endpoint: only index.php is reachable here.
DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(data|posts\.json$|\.) - [F,L]
</IfModule>
<FilesMatch "\.(json|key|lock|tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
